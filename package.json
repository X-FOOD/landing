{
  "name": "xfood-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Лендинг XFOOD Controlling — xfood.tech",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o dist/assets/style.css --minify",
    "build:copy": "node scripts/copy.mjs",
    "build": "npm run build:copy && npm run build:css",
    "dev": "npm run build:copy && tailwindcss -i src/input.css -o dist/assets/style.css --watch",
    "serve": "python3 -m http.server 8787 --directory dist"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
